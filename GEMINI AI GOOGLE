-- Non-blocking HTTP wrapper
local function sendHttpRequest(options)
	if not ReqFunc then
		return nil, "Executor has no HTTP function (" .. ReqName .. ")"
	end

	local ok, res = pcall(function()
		return ReqFunc(options)
	end)

	if ok and res then
		return res
	end
	return nil, tostring(res)
end

-- Read key directly from GUI TextBox if Enter wasn't pressed
local function findApiKeyFromGui()
	if EnteredApiKey ~= "" then
		return EnteredApiKey
	end

	local roots = { CoreGui }
	pcall(function()
		if gethui then
			table.insert(roots, gethui())
		end
	end)

	for _, root in ipairs(roots) do
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("TextBox") then
				local txt = string.match(obj.Text or "", "^%s*(.-)%s*$")
				if string.sub(txt, 1, 4) == "AIza" and #txt >= 30 then
					EnteredApiKey = txt
					return txt
				end
			end
		end
	end

	return ""
end

-- Filter out non-text/image/audio/embedding models
local function isTextChatModel(modelId)
	local lower = string.lower(modelId or "")
	if lower == "" then return false end
	if string.find(lower, "embedding") or string.find(lower, "tts") or string.find(lower, "image")
		or string.find(lower, "live") or string.find(lower, "transcribe") or string.find(lower, "translate")
		or string.find(lower, "veo") or string.find(lower, "imagen") or string.find(lower, "omni") then
		return false
	end
	return string.find(lower, "gemini") ~= nil
end

-- Order models so reliable/fast ones are tried first
local function prioritizeModels(modelsList)
	local priority = {
		"gemini-3.5-flash-lite",
		"gemini-3.1-flash-lite",
		"gemini-4-hydrogen",
		"gemini-3.8-flash",
		"gemini-3.6-flash",
		"gemini-4-neon",
		"gemini-4-argon"
	}

	local ordered = {}
	local added = {}

	for _, p in ipairs(priority) do
		for _, m in ipairs(modelsList) do
			if m == p and not added[m] then
				added[m] = true
				table.insert(ordered, m)
			end
		end
	end

	for _, m in ipairs(modelsList) do
		if isTextChatModel(m) and not added[m] then
			added[m] = true
			table.insert(ordered, m)
		end
	end

	return ordered
end

-- Send a prompt to a single model
local function sendToModel(apiKey, modelId, promptText)
	local endpoint = BaseUrl .. "/v1beta/models/" .. modelId .. ":generateContent?key=" .. apiKey
	local payload = HttpService:JSONEncode({
		contents = {
			{
				parts = {
					{ text = promptText }
				}
			}
		}
	})

	local response, err = sendHttpRequest({
		Url = endpoint,
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json"
		},
		Body = payload
	})

	if not response then
		return false, "Network Error: " .. tostring(err), 0
	end

	local code = tonumber(response.StatusCode or response.Status) or 0
	if code ~= 200 then
		return false, "HTTP " .. tostring(code) .. " on " .. modelId, code
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)

	if ok and decoded and decoded.candidates and decoded.candidates[1] and decoded.candidates[1].content then
		local parts = decoded.candidates[1].content.parts
		local replyText = (parts and parts[1] and parts[1].text) or "Empty response."
		return true, replyText, 200
	end

	return false, "Invalid JSON response from " .. modelId, code
end

-- Find the first model from the candidate list that actually replies with HTTP 200
local function findWorkingModel(apiKey, candidates, onStep)
	local lastFailure = "No working model found."
	for _, modelId in ipairs(candidates) do
		if onStep then
			onStep("Testing " .. modelId .. "...")
		end

		local ok, resultOrErr, code = sendToModel(apiKey, modelId, "Reply with only: OK")
		if ok then
			return true, modelId, resultOrErr
		end

		lastFailure = resultOrErr
		if code == 404 or code == 503 or code == 429 then
			task.wait(0.25)
		else
			return false, nil, lastFailure
		end
	end

	return false, nil, lastFailure
end

