-- Apply Super Black styling across Rayfield elements
local function applySuperBlackTheme()
	local pureBlack = Color3.fromRGB(0, 0, 0)
	local nearBlack = Color3.fromRGB(10, 10, 10)
	local darkCard = Color3.fromRGB(16, 16, 16)

	local roots = { CoreGui }
	pcall(function()
		if gethui then
			table.insert(roots, gethui())
		end
	end)

	for _, root in ipairs(roots) do
		for _, obj in ipairs(root:GetDescendants()) do
			if obj.Name == "Rayfield" then
				for _, desc in ipairs(obj:GetDescendants()) do
					if desc:IsA("UIStroke") then
						desc.Enabled = false
						desc.Thickness = 0
					elseif desc:IsA("Frame") then
						if desc.Name == "Topbar" then
							desc.BackgroundColor3 = pureBlack
						elseif desc.Name == "Main" or desc.Name == "Elements" or desc.Name == "Content" then
							desc.BackgroundColor3 = pureBlack
						else
							desc.BackgroundColor3 = darkCard
						end
					elseif desc:IsA("ScrollingFrame") then
						desc.BackgroundColor3 = pureBlack
					elseif desc:IsA("TextBox") then
						desc.BackgroundColor3 = nearBlack
						desc.TextColor3 = Color3.fromRGB(255, 255, 255)
						desc.ClearTextOnFocus = false
					end
				end
			end
		end
	end
end

