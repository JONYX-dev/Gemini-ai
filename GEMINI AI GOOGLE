-- Detect executor HTTP function safely
local function getExecutorRequest()
	if type(request) == "function" then return request, "request" end
	if type(http_request) == "function" then return http_request, "http_request" end
	if type(http) == "table" and type(http.request) == "function" then return http.request, "http.request" end
	if type(syn) == "table" and type(syn.request) == "function" then return syn.request, "syn.request" end
	if type(fluxus) == "table" and type(fluxus.request) == "function" then return fluxus.request, "fluxus.request" end
	return nil, "None found"
end

-- Detect executor clipboard function safely
local function copyToClipboard(text)
	local clipFn = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
	if type(clipFn) == "function" then
		local ok = pcall(clipFn, tostring(text or ""))
		return ok
	end
	return false
end

