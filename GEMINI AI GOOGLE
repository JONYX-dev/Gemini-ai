-- Official Google AI Check Button
GeminiTab:CreateButton({
	Name = "GEMINI OFFICIAL GOOGLE AI",
	Callback = function()
		local keyToTest = findApiKeyFromGui()
		if keyToTest == "" then
			ApiStatusLabel:Set("Status: Paste an AIza... key first.")
			Rayfield:Notify({
				Title = "GEMINI OFFICIAL GOOGLE AI",
				Content = "Enter your API key in the Api key box first.",
				Duration = 3
			})
			return
		end

		ApiStatusLabel:Set("Status: Checking official Gemini models...")

		task.spawn(function()
			local modelsUrl = BaseUrl .. "/v1beta/models?key=" .. keyToTest
			local response, err = sendHttpRequest({
				Url = modelsUrl,
				Method = "GET",
				Headers = {
					["Content-Type"] = "application/json"
				}
			})

			if not response then
				ApiStatusLabel:Set("Status: Request failed - " .. tostring(err))
				return
			end

			local code = tonumber(response.StatusCode or response.Status) or 0
			if code ~= 200 then
				ApiStatusLabel:Set("Status: Invalid key (HTTP " .. tostring(code) .. ")")
				return
			end

			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(response.Body)
			end)

			local discovered = {}
			if ok and decoded and decoded.models then
				for _, item in ipairs(decoded.models) do
					local supportsGenerate = false
					if item.supportedGenerationMethods then
						for _, method in ipairs(item.supportedGenerationMethods) do
							if method == "generateContent" then
								supportsGenerate = true
								break
							end
						end
					end

					if supportsGenerate and item.name then
						local modelId = string.gsub(item.name, "^models/", "")
						if isTextChatModel(modelId) then
							table.insert(discovered, modelId)
						end
					end
				end
			end

			local candidates = (#discovered > 0) and prioritizeModels(discovered) or prioritizeModels(FetchedChatModels)
			FetchedChatModels = candidates

			local dropdownList = { "Auto (Find Working Model)" }
			for _, m in ipairs(candidates) do
				table.insert(dropdownList, m)
			end

			pcall(function()
				ModelDropdown:Refresh(dropdownList)
				ModelDropdown:Set({ "Auto (Find Working Model)" })
			end)
			SelectedModel = "Auto (Find Working Model)"

			local worked, workingId, failReason = findWorkingModel(keyToTest, candidates, function(stepMsg)
				ApiStatusLabel:Set("Status: " .. stepMsg)
			end)

			if worked and workingId then
				LockedWorkingModel = workingId
				ActiveModelLabel:Set("Model: Auto -> " .. workingId)
				ApiStatusLabel:Set("Status: OFFICIAL GOOGLE AI READY (" .. workingId .. ")!")
				applySuperBlackTheme()
				Rayfield:Notify({
					Title = "GEMINI OFFICIAL GOOGLE AI",
					Content = "Connected on " .. workingId .. "! Ready to chat.",
					Duration = 5
				})
			else
				ApiStatusLabel:Set("Status: Failed - " .. tostring(failReason))
			end
		end)
	end
})

