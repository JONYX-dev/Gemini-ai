local function submitPromptToGemini(rawPrompt)
	local cleanPrompt = string.match(rawPrompt or "", "^%s*(.-)%s*$")
	if cleanPrompt == "" then return end

	LatestPromptText = cleanPrompt

	local keyToUse = findApiKeyFromGui()
	if keyToUse == "" then
		ResponseParagraph:Set({
			Title = "Gemini Response",
			Content = "Please paste your Api key above and tap GEMINI OFFICIAL GOOGLE AI first."
		})
		return
	end

	local modelToUse = (SelectedModel == "Auto (Find Working Model)") and LockedWorkingModel or SelectedModel
	ResponseParagraph:Set({
		Title = "Gemini Response (" .. modelToUse .. ")",
		Content = "Thinking..."
	})

	task.spawn(function()
		local ok, replyOrErr = sendToModel(keyToUse, modelToUse, cleanPrompt)
		if ok then
			LatestReplyText = replyOrErr
			ResponseParagraph:Set({
				Title = "Gemini Response (" .. modelToUse .. ")",
				Content = replyOrErr
			})
		else
			LatestReplyText = replyOrErr
			ResponseParagraph:Set({
				Title = "Gemini Response Error",
				Content = replyOrErr
			})
		end
	end)
end

