-- Helper to locate the Ask Gemini TextBox in Rayfield's GUI
local function findPromptTextBox()
	local roots = { CoreGui }
	pcall(function()
		if gethui then
			table.insert(roots, gethui())
		end
	end)

	for _, root in ipairs(roots) do
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("TextBox") and string.find(string.lower(obj.PlaceholderText or ""), "keyboard") then
				return obj
			end
		end
	end
	return nil
end

